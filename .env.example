# Public URL of the deployed site (used for absolute Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: higher-quality Persian translation with Claude (billed by Anthropic).
# ANTHROPIC_API_KEY=

# Optional: your own e-mail raises the free MyMemory quota (~5k → ~50k characters/day).
# MYMEMORY_EMAIL=

# Optional: where the translation cache is persisted.
# TRANSLATION_CACHE_FILE=

# Optional: where Open Library responses and cover images are cached on disk.
# KETABGARD_CACHE_DIR=
